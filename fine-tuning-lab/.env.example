# Untuk synthetic data generation via Groq LLM
GROQ_API_KEY=gsk_your_key_here

# Untuk push model ke HF Hub (Minggu 7)
# Generate di https://huggingface.co/settings/tokens (pilih type: Write)
# Login CLI: hf auth login --token $HF_TOKEN  (note: `huggingface-cli` deprecated, pakai `hf`)
HF_TOKEN=hf_your_token_here

# Config
SYNTHETIC_MODEL=llama-3.3-70b-versatile
SAMPLES_PER_INTENT=55
BATCH_SIZE=5
